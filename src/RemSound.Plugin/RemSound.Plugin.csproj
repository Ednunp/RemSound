<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RemSound as a VST3 plugin (v6.0).

    Same engine as the app — same protocol, same encryption, same jitter buffer, same relay — with
    the sound card swapped for the DAW. It references Core/Sender/Receiver (the engine) and
    RemSound.Ui (the accessible controls) but NOT the app: a plugin must not drag a WinForms
    application, its tray icon, its single-instance lock or its service machinery into someone
    else's DAW process.

    ONE PERSON PER TRACK (Ed, 2026-08-15): an instance either sends this DAW track, or receives one
    chosen peer onto it. Splitting one machine's devices into separate streams was considered and
    dropped — independent jitter buffers would let a guitar and a vocal from the same performance
    drift apart at the far end, which is worse than latency.

    Route chosen: AudioPlugSharp (MIT, actively maintained, targets net10.0, several plugins shipping
    on it) because it is the only .NET route that supports a real WinForms editor — and real WinForms
    controls are the entire reason this plugin can be screen-reader accessible when almost no
    commercial plugin is.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemSound.Plugin</AssemblyName>
    <RootNamespace>RemSound.Plugin</RootNamespace>
    <!-- A plugin is loaded INTO a host process; it is a library, never an exe. -->
    <OutputType>Library</OutputType>

    <!-- SHIP THE DEPENDENCIES.

         A .NET LIBRARY build does not copy its NuGet assemblies to the output folder. An application
         does; a library normally doesn't need to, because whoever references it brings them along. A
         VST plugin has no such parent — the DAW loads this folder and nothing else, so anything
         missing from it simply is not there.

         Without this the shipped folder had no NAudio, no Concentus and no native opus.dll, so
         RemSound.Plugin.dll failed the moment it touched a resampler or a filter. Reaper scanned the
         .vst3, got no plugins back, and cached that result — which is why it never appeared in the
         effects list and left no log of its own to explain why (2026-08-15, diagnosed from Reaper's
         own vstplugins64.ini, where our entry had a timestamp and no plugin name while every working
         plugin had a name beside it).

         The runtime identifier brings the native opus.dll along. NOT self-contained: RemSound is
         framework-dependent everywhere and a plugin that dragged a private copy of .NET into
         somebody's DAW would be worse. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The gate (in RemSound.App) drives the plugin's audio bridge directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>RemSound</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="AudioPlugSharp" Version="0.7.13" />
    <!-- Pinned to the same version as AudioPlugSharp. A floating "*" resolved to whatever was newest
         at restore time, so two builds of one commit could ship different VST3 bridges. -->
    <PackageReference Include="AudioPlugSharpVst3" Version="0.7.13" />
  </ItemGroup>

  <!-- OUR OWN VST3 LOADER, NOT THE PACKAGE'S.

       The package's loader reports no tail, so hosts that go by the tail stop calling an effect whose input is
       silent - and a receiving RemSound is exactly that. Ours is the same loader with one override,
       getTailSamples() = kInfiniteTail (third-party\AudioPlugSharpVst\README.md has why and how to rebuild it).
       The package's own target copies its loader first; this one runs after it and puts ours in its place, so
       everything downstream (the app's plugin\ folder, publish, the installer) ships ours.

       Built for AudioPlugSharpVst3 0.7.13. A loader from one version with the managed side of another is a
       mismatch nobody would see until a DAW failed to load it, so a version change stops the build. -->
  <PropertyGroup>
    <RemSoundPatchedBridge>$(MSBuildThisFileDirectory)..\..\third-party\AudioPlugSharpVst\AudioPlugSharpVst.vst3</RemSoundPatchedBridge>
    <RemSoundPatchedBridgeFor>0.7.13</RemSoundPatchedBridgeFor>
  </PropertyGroup>
  <Target Name="RemSoundPatchedBridge" AfterTargets="AudioPlugSharpVst3">
    <Error Condition="!Exists('$(RemSoundPatchedBridge)')" Text="RemSound's patched VST3 loader is missing: $(RemSoundPatchedBridge)" />
    <Error Condition="'%(PackageReference.Identity)' == 'AudioPlugSharpVst3' And '%(PackageReference.Version)' != '$(RemSoundPatchedBridgeFor)'"
           Text="AudioPlugSharpVst3 is now %(PackageReference.Version) but RemSound's patched loader was built for $(RemSoundPatchedBridgeFor). Rebuild it from the matching commit (third-party\AudioPlugSharpVst\README.md)." />
    <Copy SourceFiles="$(RemSoundPatchedBridge)" DestinationFiles="$(TargetDir)$(TargetName)Bridge.vst3" />
  </Target>

  <ItemGroup>
    <!-- Its own copy of the manual, for context help (2026-09-25): inside a DAW the app's copy is out of reach. It
         travels with the plugin's files into the app's plugin\ folder, and Install plugin copies it with the rest. -->
    <Content Include="..\..\readme.html">
      <Link>readme.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemSound.Core\RemSound.Core.csproj" />
    <ProjectReference Include="..\RemSound.Sender\RemSound.Sender.csproj" />
    <ProjectReference Include="..\RemSound.Receiver\RemSound.Receiver.csproj" />
    <ProjectReference Include="..\RemSound.Ui\RemSound.Ui.csproj" />
  </ItemGroup>

</Project>
