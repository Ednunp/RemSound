<Project Sdk="Microsoft.NET.Sdk">

  <!-- The gate's helpers, not part of RemSound: "watch" listens to every accessibility event on this desktop while the gate
       runs and says which ones, from RemSound's windows, a screen reader would have spoken or a sighted person seen;
       "hidden" runs a program on a desktop nobody is looking at. Built and run by run-tests.ps1; never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
